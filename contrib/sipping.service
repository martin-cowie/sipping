[Unit]
Description=sipping SIP OPTIONS health monitor
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/perl /opt/sipping/bin/sipping --listen 127.0.0.1:8080 --target udp:sip.example.com
Restart=on-failure
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
